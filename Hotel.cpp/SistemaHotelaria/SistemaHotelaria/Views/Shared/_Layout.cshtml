@{
    string controllerAtual = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sistema de Hotelaria</title>
    <link rel="stylesheet" href="/css/site.css" />
</head>
<body>
    <header>
        <div class="topo">
            <a href="/" class="marca">Sistema de <span>Hotelaria</span></a>
            <nav>
                <a href="/Hospedes" class="@(controllerAtual == "Hospedes" ? "ativo" : "")">Hóspedes</a>
                <a href="/Quartos" class="@(controllerAtual == "Quartos" ? "ativo" : "")">Quartos</a>
                <a href="/Reservas" class="@(controllerAtual == "Reservas" ? "ativo" : "")">Reservas</a>
            </nav>
        </div>
    </header>

    <main>
        <div class="cartao">
            @RenderBody()
        </div>
    </main>
</body>
</html>