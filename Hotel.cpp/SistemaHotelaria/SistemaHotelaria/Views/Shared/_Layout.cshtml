<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sistema de Hotelaria</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 0; }
        header { background: #1f3a5f; color: white; padding: 16px 24px; }
        header h1 { margin: 0 0 8px 0; font-size: 22px; }
        nav a { color: white; margin-right: 16px; text-decoration: none; }
        main { padding: 24px; }
        table { border-collapse: collapse; }
        th, td { border: 1px solid #ccc; padding: 6px 10px; text-align: left; }
        th { background: #f0f0f0; }
    </style>
</head>
<body>
    <header>
        <h1>Sistema de Hotelaria</h1>
        <nav>
            <a href="/Hospedes">Hóspedes</a>
            <a href="/Quartos">Quartos</a>
            <a href="/Reservas">Reservas</a>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>
</body>
</html>